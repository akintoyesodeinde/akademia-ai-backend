# Akademia AI Backend — Environment Configuration Template
# Never commit real production secrets to version control.

APP_NAME="Akademia AI"
APP_ENV="development"
DEBUG="false"
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# Database Roles:
# - DATABASE_URL uses the least-privilege application role (akademia_app) with NOBYPASSRLS, NOSUPERUSER
# - MIGRATION_DATABASE_URL uses the schema owner/migration role (akademia_migrator)
# - WORKER_DATABASE_URL uses the least-privilege background worker role (akademia_worker) with NOBYPASSRLS, NOSUPERUSER
DATABASE_URL="postgresql+asyncpg://akademia_app:akademia_app_dev_pw@localhost:5436/akademia_ai"
MIGRATION_DATABASE_URL="postgresql+asyncpg://akademia_migrator:akademia_migrator_dev_pw@localhost:5436/akademia_ai"
WORKER_DATABASE_URL="postgresql+asyncpg://akademia_worker:akademia_worker_dev_pw@localhost:5436/akademia_ai"

# Redis
REDIS_URL="redis://localhost:6386/0"

# Authentication & Security
JWT_SECRET_KEY="change-me-in-production-use-at-least-32-random-bytes-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="14"
SESSION_COOKIE_NAME="akademia_refresh_token"
CSRF_COOKIE_NAME="akademia_csrf_token"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"

# CORS
CORS_ORIGINS='["http://localhost:5173","http://localhost:5175","http://127.0.0.1:5175"]'

# Object Storage (Private local storage abstraction)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage_data"
MAX_UPLOAD_SIZE_BYTES="26214400"

# AI Provider Configuration (Provider-Neutral)
# Supported values: "deterministic" (local dev/testing fallback), "openai_compatible"
AI_PROVIDER="deterministic"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_CHAT_MODEL="akademia-grounded-v1"
AI_EMBEDDING_MODEL="akademia-embed-v1"
AI_EMBEDDING_DIMENSION="64"
AI_MAX_INPUT_TOKENS="6000"
AI_MAX_OUTPUT_TOKENS="1500"
AI_REQUEST_TIMEOUT_SECONDS="30"
AI_MAX_RETRIES="2"

# Email Configuration
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM_EMAIL="noreply@akademia.ai"

# Rate Limiting
RATE_LIMIT_DEFAULT_PER_MINUTE="120"
RATE_LIMIT_AUTH_PER_MINUTE="20"
RATE_LIMIT_AI_PER_MINUTE="30"
